# Copy to .env.auth0 or run scripts/setup-auth0.sh, which writes this file.
# Do not commit real client secrets.

OAUTH2C_ISSUER=https://YOUR_TENANT.us.auth0.com
OAUTH2C_AUDIENCE=https://oauth2c.local
OAUTH2C_CALLBACK=http://localhost:9876/callback
OAUTH2C_SCOPE=demo:read

OAUTH2C_WEB_CLIENT_ID=
OAUTH2C_WEB_CLIENT_SECRET=

OAUTH2C_POST_CLIENT_ID=
OAUTH2C_POST_CLIENT_SECRET=

OAUTH2C_SPA_CLIENT_ID=
OAUTH2C_DEVICE_CLIENT_ID=

OAUTH2C_USERNAME=oauth2c-demo@example.com
OAUTH2C_PASSWORD=
